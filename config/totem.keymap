#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <100>;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        Return {
            bindings = <&kp RETURN>;
            key-positions = <16 17 18>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
           &kp Q  &kp W  &kp E         &kp R        &kp T    &kp Y  &kp U                 &kp I                &kp O       &kp P
           &kp A  &kp S  &hm LSHIFT D  &hm LCTRL F  &kp G    &kp H  &hm RCTRL J           &hm RSHIFT K         &hm RALT L  &kp SEMICOLON
&lt 3 ESC  &kp Z  &kp X  &kp C         &kp V        &kp B    &kp N  &kp M                 &kp COMMA            &kp DOT     &kp SLASH      &kp APOSTROPHE
                         &kp LCTRL     &lt 1 SPACE  &mo 1    &mo 2  &hm LSHIFT BACKSPACE  &mt DELETE LEFT_GUI
            >;
        };

        NumsSyms {
            display-name = "Numbers and Symbols";
            bindings = <
           &kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3    &kp NUMBER_4      &kp N5         &kp NUMBER_6  &kp NUMBER_7       &kp NUMBER_8     &kp NUMBER_9  &kp NUMBER_0
           &kp EXCL      &kp AT_SIGN    &kp HASH        &kp DOLLAR        &kp PERCENT    &kp CARET     &kp AMPS           &kp ASTERISK     &kp MINUS     &kp EQUAL
&kp GRAVE  &kp TILDE     &kp BACKSLASH  &kp LEFT_BRACE  &kp LEFT_BRACKET  &kp LPAR       &kp RPAR      &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp UNDER     &kp PLUS      &kp PIPE
                                        &trans          &trans            &trans         &trans        &trans             &trans
            >;
        };

        NavSettings {
            display-name = "Navigation and Settings";
            bindings = <
        &trans  &trans           &kp END            &trans                &trans                  &trans    &trans          &trans        &trans     &kp HOME
        &trans  &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &kp C_BRIGHTNESS_INC  &kp C_BRIGHTNESS_DEC    &kp LEFT  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &trans
&trans  &trans  &trans           &trans             &trans                &trans                  &trans    &trans          &trans        &trans     &trans    &trans
                                 &trans             &trans                &trans                  &trans    &trans          &trans
            >;
        };

        Mouse {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
        &trans  &trans  &trans  &trans  &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans          &trans        &trans           &trans  &trans
                        &trans  &trans  &trans    &mkp LCLK       &mkp MCLK       &mkp RCLK
            >;
        };
    };
};
